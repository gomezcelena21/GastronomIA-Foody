# Copiá este archivo como backend/.env y completá los valores. NUNCA subas el .env.
GEMINI_API_KEY=pegá_acá_tu_clave_nueva_de_Google_AI_Studio
GEMINI_MODEL=gemini-3.5-flash-lite
PROVIDER=gemini
PORT=8001

# Conexión a PostgreSQL (usuario:clave@servidor:puerto/base)
DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/gastro_ia

# 1 = usa Gemini para analizar reseñas (gasta cuota). 0 = reglas simples (recomendado)
VALORACIONES_CON_IA=0

# Cuota de Gemini (plan gratis): pedidos por minuto que el backend se permite y segundos máximos de espera
# antes de responder "sin IA". Si tu modelo tiene un límite distinto, miralo en Google AI Studio.
GEMINI_RPM=10
GEMINI_MAX_ESPERA=20
# Si Gemini no contesta en estos segundos, se responde con la base (modo sin IA).
GEMINI_TIMEOUT=12
# Crear índices y actualizar estadísticas al iniciar (recomendado; 1 = sí).
OPTIMIZAR_AL_INICIAR=1
# Conexiones simultáneas a PostgreSQL.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Login con Google (ver docs/despliegue_y_login.md)
GOOGLE_CLIENT_ID=
# Clave larga y secreta para firmar las sesiones (32+ caracteres). Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Dominios del frontend permitidos (separados por coma). En producción: https://tu-app.vercel.app
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Máximo de consultas al chat por usuario y por día
CONSULTAS_POR_DIA=10
# Sin registrarse: consultas por IP y por día, y tope general por día entre todos los invitados
ANONIMOS_POR_DIA=5
ANONIMOS_POR_DIA_GLOBAL=300
# En el servidor publicado poné ENTORNO=produccion: oculta /docs, /redoc y /openapi.json
ENTORNO=desarrollo
# Administración de comercios: correos de Google (separados por coma) que pueden aprobar o rechazar comercios
ADMIN_EMAILS=
# 1 = los comercios se aprueban solos (solo para pruebas y demos); 0 = los aprueba un administrador
COMERCIOS_AUTOAPROBADOS=0

# Monitoreo de errores (opcional). Sin DSN no se inicializa Sentry.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=desarrollo
# SENTRY_TRACES_SAMPLE_RATE=0

# Enriquecimiento de datos (opcional).
# NOMINATIM_EMAIL=tu-correo@gmail.com
# GOOGLE_MAPS_API_KEY=
